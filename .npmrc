# Route package downloads through Takumi Guard to block malicious packages before install:
# https://flatt.tech/takumi/features/guard/
#
# Why not GitHub Package Firewall:
# GitHub Package Firewall is only available for GitHub Enterprise Cloud (GHEC),
# so personal open source repositories cannot use it:
# - https://github.blog/changelog/2026-10-20-github-package-firewall-in-public-preview/
# - https://github.com/kachick/wait-other-jobs/issues/1426
registry=https://npm.flatt.tech/
