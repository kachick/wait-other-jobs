{
  "typescript": {
    "quoteStyle": "preferSingle",
    "useBraces": "always",
    "module.sortImportDeclarations": "maintain",
    "module.sortExportDeclarations": "maintain",
    "importDeclaration.sortNamedImports": "maintain",
    "exportDeclaration.sortNamedExports": "maintain"
  },
  "json": {
    "trailingCommas": "never"
  },
  "markdown": {},
  "yaml": { "quotes": "preferSingle" },
  "excludes": ["dist", "pnpm-lock.yaml"],
  "plugins": [
    "npm:@dprint/typescript@0.96.1",
    "npm:@dprint/json@0.24.0",
    "npm:@dprint/markdown@0.24.0",
    "npm:@dprint/toml@0.8.0",
    "npm:dprint-plugin-yaml@0.6.0",
    "npm:@kachick/dprint-plugin-nix@0.1.1"
  ]
}
