{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "dependencyDashboard": true,
  "labels": [
    "dependencies",
    "renovate"
  ],
  "enabledManagers": [
    "custom.regex",
    "npm"
  ],
  "extends": [
    "schedule:weekdays",
    "github>kachick/renovate-config-dprint#1.4.0"
  ],
  "vulnerabilityAlerts": {
    "enabled": true
  },
  "rangeStrategy": "bump",
  "ignoreDeps": ["node", "pnpm"],
  "minimumReleaseAge": "3 days",
  "packageRules": [
    {
      "matchDatasources": [
        "npm"
      ],
      "matchPackageNames": [
        "@types/**"
      ],
      "matchUpdateTypes": ["major"],
      "enabled": false
    },
    {
      "matchDatasources": [
        "npm"
      ],
      "matchPackageNames": [
        "undici"
      ],
      "matchUpdateTypes": ["major", "minor"],
      "enabled": false
    },
    // Temporarily pause zod updates until the root cause is clear and resolved:
    // - https://github.com/orgs/community/discussions/208477
    // - https://github.com/kachick/wait-other-jobs/issues/1420
    {
      "matchDatasources": [
        "npm"
      ],
      "matchPackageNames": [
        "zod"
      ],
      "enabled": false
    }
  ]
}
