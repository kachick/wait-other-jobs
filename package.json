{
  "name": "wait-other-jobs",
  "version": "1.0.0",
  "description": "",
  "keywords": [],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/kachick/wait-other-jobs.git"
  },
  "license": "MIT",
  "author": "Kenichi Kamiya <kachick1@gmail.com>",
  "type": "module",
  "main": "lib/main.js",
  "scripts": {
    "setup": "pnpm install --frozen-lockfile",
    "test": "node --test '__tests__/**/*.test.ts'",
    "typecheck": "tsc",
    "cleanup_build": "rm -rf ./lib ./dist",
    "build": "pnpm run cleanup_build && node esbuild.config.ts",
    "fmt": "dprint fmt",
    "lint": "node scripts/lint.ts",
    "check_no_git_diff": "(git add --intent-to-add . && git diff --exit-code) || (echo 'You should commit all diff before running tests'; exit 1)",
    "all": "pnpm run typecheck && pnpm run test && pnpm run lint && pnpm run build",
    "repl": "pnpm dlx tsx",
    "update_flake": "nix flake update --commit-lock-file",
    "sync_workflow_deps": "git ls-files '.github' | xargs nix run 'github:kachick/selfup/v1.3.1' -- run"
  },
  "dependencies": {
    "@actions/core": "^3.0.1",
    "@actions/github": "^9.1.1",
    "@octokit/core": "^7.0.8",
    "@octokit/graphql-schema": "^15.26.1",
    "@octokit/plugin-paginate-graphql": "^6.0.0",
    "esbuild": "^0.28.2",
    "jsonc-parser": "^3.3.1",
    "temporal-polyfill": "^1.0.5",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@tsconfig/bases": "^1.0.28",
    "@types/node": "^24.19.1"
  },
  "engines": {
    "node": ">=24.x"
  }
}
